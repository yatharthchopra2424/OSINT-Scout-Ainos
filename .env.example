# OSINT Scout — copy to .env and fill in.
# The app runs with NO keys at all in fixture mode (see SOURCE_MODE below).

# --- NVIDIA NIM (open Nemotron models) ---------------------------------------
# Get a free key at https://build.nvidia.com  ->  "Get API Key"
NVIDIA_API_KEY=

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_EMBED=nvidia/nemotron-3-embed-1b

# --- source of documents ------------------------------------------------------
# fixture = read frozen documents from eval/fixtures/docs  (no network, no keys)
# web     = live Tavily search + page fetch                (needs TAVILY_API_KEY)
SOURCE_MODE=fixture
TAVILY_API_KEY=

# --- retrieval ----------------------------------------------------------------
# chroma = Chroma vector DB (default).  numpy = built-in fallback store.
VECTOR_BACKEND=chroma
RETRIEVAL_K=4
RETRIEVAL_K_RETRY=8

# lexical = offline hashing embedder, no API key needed (used for the eval
#           baseline and so the pipeline runs before you have a key).
# nemotron = NVIDIA nemotron-3-embed-1b.
EMBED_BACKEND=lexical

# --- verification gate --------------------------------------------------------
# A fact must score at least this to survive the verify node.
SUPPORT_THRESHOLD=0.5

# Who writes the brief's summary paragraph. `template` is deterministic and free;
# `llm` reads better but costs a third model call per run.
SUMMARY_MODEL=template
